<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Calculadora Oficina</title>

<style>
body{
    margin:0;
    font-family:Arial;
    background:#111;
    color:white;
}

header{
    background:#1c1c1c;
    padding:20px;
    text-align:center;
    font-size:28px;
    font-weight:bold;
}

.tabs{
    display:flex;
    overflow:auto;
    background:#222;
}

.tab{
    padding:15px 20px;
    cursor:pointer;
    border:none;
    background:#222;
    color:white;
    font-size:16px;
}

.tab.active{
    background:#00aa66;
}

.content{
    display:none;
    padding:20px;
}

.content.active{
    display:block;
}

.item{
    background:#1d1d1d;
    margin-bottom:10px;
    padding:15px;
    border-radius:10px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.total{
    position:fixed;
    bottom:0;
    width:100%;
    background:#000;
    padding:20px;
    font-size:28px;
    color:#00ff88;
    border-top:2px solid #00ff88;
}

input[type="number"]{
    width:60px;
}
</style>
</head>

<body>

<header>
Calculadora Oficina
</header>

<div class="tabs">
    <button class="tab active" onclick="openTab('nitro', this)">Nitro</button>
    <button class="tab" onclick="openTab('stage', this)">Stage</button>
    <button class="tab" onclick="openTab('reparo', this)">Reparos</button>
    <button class="tab" onclick="openTab('lockpick', this)">Lockpick</button>
    <button class="tab" onclick="openTab('guincho', this)">Guincho</button>
</div>

<!-- NITRO -->
<div id="nitro" class="content active">

<div class="item">
<label>
<input type="checkbox" value="5625" onchange="calcular()">
 Garrafa Nitro Pequena — $5.625
</label>
</div>

<div class="item">
<label>
<input type="checkbox" value="20000" onchange="calcular()">
 Garrafa Nitro Grande — $20.000
</label>
</div>

<div class="item">
<label>
REFIL Nitro — $625
</label>

<input type="number" min="0" value="0"
data-price="625"
oninput="calcular()">
</div>

</div>

<!-- STAGE -->
<div id="stage" class="content">

<div class="item">
<label>
<input type="checkbox" value="7500" onchange="calcular()">
 ECU — $7.500
</label>
</div>

<div class="item">
<label>
<input type="checkbox" value="13750" onchange="calcular()">
 Kit Freio — $13.750
</label>
</div>

<div class="item">
<label>
<input type="checkbox" value="15000" onchange="calcular()">
 Escape Esportivo — $15.000
</label>
</div>

</div>

<!-- REPAROS -->
<div id="reparo" class="content">

<div class="item">
<label>
<input type="checkbox" value="750" onchange="calcular()">
 Reparo ECU — $750
</label>
</div>

<div class="item">
<label>
<input type="checkbox" value="200" onchange="calcular()">
 Lataria — $200
</label>
</div>

<div class="item">
<label>
Motor — $700
</label>

<input type="number" min="0" value="0"
data-price="700"
oninput="calcular()">
</div>

</div>

<!-- LOCKPICK -->
<div id="lockpick" class="content">

<div class="item">
<label>
Lockpick — $250
</label>

<input type="number" min="0" value="0"
data-price="250"
oninput="calcular()">
</div>

</div>

<!-- GUINCHO -->
<div id="guincho" class="content">

<div class="item">
<label>
<input type="checkbox" value="1500" onchange="calcular()">
 Los Santos — $1500
</label>
</div>

<div class="item">
<label>
<input type="checkbox" value="500" onchange="calcular()">
 Sandy/Grape — $500
</label>
</div>

</div>

<div class="total">
TOTAL: $<span id="valorTotal">0</span>
</div>

<script>

function openTab(tabId, el){

    document.querySelectorAll('.content')
    .forEach(tab => tab.classList.remove('active'));

    document.querySelectorAll('.tab')
    .forEach(tab => tab.classList.remove('active'));

    document.getElementById(tabId)
    .classList.add('active');

    el.classList.add('active');
}

function calcular(){

    let total = 0;

    document.querySelectorAll('input[type="checkbox"]')
    .forEach(item => {
        if(item.checked){
            total += Number(item.value);
        }
    });

    document.querySelectorAll('input[type="number"]')
    .forEach(item => {
        total += Number(item.value) *
        Number(item.dataset.price);
    });

    document.getElementById('valorTotal')
    .innerText = total.toLocaleString('pt-BR');
}

</script>

</body>
</html>
